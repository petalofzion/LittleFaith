<?xml version="1.0" encoding="UTF-8"?>
<osis>
  <osisText osisIDWork="Sample" osisRefWork="Sample" xml:lang="en">
    <div type="book" osisID="Gen">
      <chapter osisID="Gen.1">
        <verse osisID="Gen.1.1">In the beginning God created the heaven and the earth.</verse>
        <verse osisID="Gen.1.2">And the earth was without form, and void.</verse>
        <verse osisID="Gen.1.3-Gen.1.4">And God said, Let there be light.</verse>
        <verse osisID="Gen.1.5 Gen.1.6">And God called the light Day.</verse>
      </chapter>
    </div>
  </osisText>
</osis>
